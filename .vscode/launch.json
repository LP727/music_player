{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Music Player",
      "cargo": {
        "args": ["build"]
      },
      "program": "${cargo:program}",

      "env": {
        "RUST_LOG": "debug"
      },
      "args": [],
      "stopOnEntry": false
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Tests",
      "cargo": {
        "args": ["test", "--lib"]
      },
      "program": "${cargo:program}",
      "args": ["${input:targetTest}"],
      "stopOnEntry": true
    }
  ],
  "inputs": [
    {
      "id": "targetTest",
      "type": "pickString",
      "description": "What module do you want to test?",
      "options": ["toml_source", "library"],
      "default": "toml_source"
    }
  ]
}
